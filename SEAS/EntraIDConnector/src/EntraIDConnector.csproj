<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>EntraIDConnector</AssemblyName>
    <RootNamespace>EntraID.MIM.Connector</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <OutputPath>..\bin\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <!--
      Microsoft.MetadirectoryServicesEx.dll = přejmenovaná MIM assembly.
      Zdrojová cesta na MIM serveru:
        C:\Program Files\Microsoft Forefront Identity Manager\2010\
          Synchronization Service\Bin\Assemblies\Microsoft.MetadirectoryServices.dll
    -->
    <Reference Include="Microsoft.MetadirectoryServices">
      <HintPath>..\lib\Microsoft.MetadirectoryServicesEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
